		<script>

		function rePositionChatBox (){
			if(document.getElementById('LeadboosterContainer')){
				var chatBox = document.getElementById('LeadboosterContainer');

				if(window.innerWidth > 1856){
					var newRightPos = (window.innerWidth - 1856) / 2;
					chatBox.setAttribute('style', 'right:' + newRightPos + 'px !important');

				}

			}
		}

		window.addEventListener('load', function(){
			setInterval(() => {
				rePositionChatBox()
			}, 1000);
		});


		</script>
