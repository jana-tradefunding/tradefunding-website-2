# Trade Funding Connect — landing page environment variables
# Copy this file to .env.local for local development, and set the same
# keys in your host's dashboard (e.g. Vercel → Settings → Environment Variables)
# for production. Never commit real values.

# Resend API key — used to email each enquiry to the sales inbox.
# Get one at https://resend.com (Verified domain required for the "from" address).
RESEND_API_KEY=

# HMAC signing secret for the anti-spam form token.
# Any long random string (32+ chars). Generate with: openssl rand -hex 32
FORM_TOKEN_SECRET=

# Slack incoming webhook — posts each enquiry to a channel. Optional:
# if unset, the form still works and just skips the Slack notification.
SLACK_WEBHOOK_URL=

# Where enquiry emails are delivered. Defaults to support@tradefunding.com.au.
LEAD_EMAIL_TO=support@tradefunding.com.au

# The "from" address on enquiry emails. Must be on a Resend-verified domain.
LEAD_EMAIL_FROM=Trade Funding Connect Enquiries <noreply@tradefunding.au>
