# Trade Funding Connect — landing page environment variables
# Copy this file to .env.local for local development, and set the same
# keys in your host's dashboard (e.g. Vercel → Settings → Environment Variables)
# for production. Never commit real values.

# Resend API key — used to email each enquiry to the sales inbox.
# Get one at https://resend.com (Verified domain required for the "from" address).
RESEND_API_KEY=

# HMAC signing secret for the anti-spam form token.
# Any long random string (32+ chars). Generate with: openssl rand -hex 32
FORM_TOKEN_SECRET=

# Slack incoming webhook — posts each enquiry to a channel. Optional:
# if unset, the form still works and just skips the Slack notification.
SLACK_WEBHOOK_URL=

# Where enquiry emails are delivered. Defaults to support@tradefunding.com.au.
LEAD_EMAIL_TO=support@tradefunding.com.au

# The "from" address on enquiry emails. Must be on a Resend-verified domain.
LEAD_EMAIL_FROM=Trade Funding Connect Enquiries <noreply@tradefunding.au>

# Upstash Redis — backs the per-IP rate limiter (3/hour, 10/day) on
# /api/request-call. Get both values from the Upstash free tier:
# https://console.upstash.com → create a Redis database → REST API tab.
# Vercel KV is a drop-in alternative (same REST API under the hood) if
# you'd rather provision it from the Vercel dashboard instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — server-side secret for verifying the anti-bot
# widget token submitted with /api/form-token and /api/request-call.
# Get it free at https://dash.cloudflare.com/?to=/:account/turnstile →
# create a widget → Secret Key. The matching public Site Key is NOT a
# secret and doesn't belong here — it gets embedded directly in the
# Turnstile widget markup in connect/index.html once that front-end
# change lands (see the follow-up note in api/_lib/turnstile.js — it
# hasn't landed yet, so this backend check will fail closed until it does).
TURNSTILE_SECRET_KEY=
